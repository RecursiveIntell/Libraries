{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DegradationKindV1": {
      "enum": [
        "thin_export",
        "missing_proof",
        "missing_replay",
        "scope_withheld",
        "evidence_unavailable",
        "oracle_unavailable",
        "budget_exceeded",
        "exactness_downgraded",
        "advisory_only"
      ],
      "type": "string"
    },
    "ExactnessEscalationRuleV1": {
      "properties": {
        "block_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "escalate_to": {
          "$ref": "#/definitions/ExactnessLevelV1"
        },
        "when_degraded": {
          "$ref": "#/definitions/DegradationKindV1"
        }
      },
      "required": [
        "escalate_to",
        "when_degraded"
      ],
      "type": "object"
    },
    "ExactnessLevelV1": {
      "enum": [
        "exact",
        "conservative",
        "approximate",
        "heuristic"
      ],
      "type": "string"
    }
  },
  "properties": {
    "achieved_exactness": {
      "$ref": "#/definitions/ExactnessLevelV1"
    },
    "budget_units": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "degradation": {
      "items": {
        "$ref": "#/definitions/DegradationKindV1"
      },
      "type": "array"
    },
    "escalation_rules": {
      "items": {
        "$ref": "#/definitions/ExactnessEscalationRuleV1"
      },
      "type": "array"
    },
    "exactness_budget_id": {
      "type": "string"
    },
    "failure_artifact_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requested_exactness": {
      "$ref": "#/definitions/ExactnessLevelV1"
    },
    "schema_version": {
      "type": "string"
    },
    "semantics_profile_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "units_consumed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "achieved_exactness",
    "budget_units",
    "exactness_budget_id",
    "requested_exactness",
    "schema_version",
    "semantics_profile_id",
    "subject",
    "units_consumed"
  ],
  "title": "ExactnessBudgetV1",
  "type": "object"
}
