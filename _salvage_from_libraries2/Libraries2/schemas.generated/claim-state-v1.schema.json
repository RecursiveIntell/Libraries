{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DegradationKindV1": {
      "enum": [
        "thin_export",
        "missing_proof",
        "missing_replay",
        "scope_withheld",
        "evidence_unavailable",
        "oracle_unavailable",
        "budget_exceeded",
        "exactness_downgraded",
        "advisory_only"
      ],
      "type": "string"
    },
    "EvidenceAdmissibilityV1": {
      "enum": [
        "admissible",
        "restricted",
        "inadmissible",
        "unknown"
      ],
      "type": "string"
    },
    "ExactnessLevelV1": {
      "enum": [
        "exact",
        "conservative",
        "approximate",
        "heuristic"
      ],
      "type": "string"
    },
    "SemanticViewV1": {
      "enum": [
        "canonical",
        "projection",
        "runtime",
        "causal_advisory",
        "operator"
      ],
      "type": "string"
    },
    "TruthStateV1": {
      "enum": [
        "asserted",
        "supported",
        "refuted",
        "abstained",
        "unknown"
      ],
      "type": "string"
    }
  },
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim_state_id": {
      "type": "string"
    },
    "degradation": {
      "items": {
        "$ref": "#/definitions/DegradationKindV1"
      },
      "type": "array"
    },
    "evidence_admissibility": {
      "$ref": "#/definitions/EvidenceAdmissibilityV1"
    },
    "exactness": {
      "$ref": "#/definitions/ExactnessLevelV1"
    },
    "policy_action_allowed": {
      "type": "boolean"
    },
    "proof_obligations_remaining": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "semantics_profile_id": {
      "type": "string"
    },
    "truth_state": {
      "$ref": "#/definitions/TruthStateV1"
    },
    "view": {
      "$ref": "#/definitions/SemanticViewV1"
    }
  },
  "required": [
    "claim_id",
    "claim_state_id",
    "evidence_admissibility",
    "exactness",
    "policy_action_allowed",
    "schema_version",
    "semantics_profile_id",
    "truth_state",
    "view"
  ],
  "title": "ClaimStateV1",
  "type": "object"
}
