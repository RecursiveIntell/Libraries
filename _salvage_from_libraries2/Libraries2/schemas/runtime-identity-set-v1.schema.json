{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RuntimeIdentityRecordV1": {
      "properties": {
        "evidence_ref": {
          "type": "string"
        },
        "local_subject_ref": {
          "type": "string"
        },
        "runtime_name": {
          "type": "string"
        },
        "shared_subject_ref": {
          "type": "string"
        }
      },
      "required": [
        "evidence_ref",
        "local_subject_ref",
        "runtime_name",
        "shared_subject_ref"
      ],
      "type": "object"
    },
    "SurfaceStatus": {
      "description": "Shared publication-status primitive for thin governance/profile surfaces.\n\nDomain crates may only use the variants they need, but they should not redefine the status family locally because that creates schema drift bait.",
      "enum": [
        "advisory_only",
        "non_admitted",
        "degraded",
        "horizon_only"
      ],
      "type": "string"
    }
  },
  "properties": {
    "canonical_owner": {
      "type": "string"
    },
    "identities": {
      "default": [],
      "items": {
        "$ref": "#/definitions/RuntimeIdentityRecordV1"
      },
      "type": "array"
    },
    "publication_status": {
      "$ref": "#/definitions/SurfaceStatus"
    },
    "runtime_identity_set_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "treaty_bundle_id": {
      "type": "string"
    }
  },
  "required": [
    "canonical_owner",
    "publication_status",
    "runtime_identity_set_id",
    "schema_version",
    "treaty_bundle_id"
  ],
  "title": "RuntimeIdentitySetV1",
  "type": "object"
}
