{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DegradationKindV1": {
      "enum": [
        "thin_export",
        "missing_proof",
        "missing_replay",
        "scope_withheld",
        "evidence_unavailable",
        "oracle_unavailable",
        "budget_exceeded",
        "exactness_downgraded",
        "advisory_only"
      ],
      "type": "string"
    },
    "EvidenceAdmissibilityV1": {
      "enum": [
        "admissible",
        "restricted",
        "inadmissible",
        "unknown"
      ],
      "type": "string"
    },
    "ExactnessLevelV1": {
      "enum": [
        "exact",
        "conservative",
        "approximate",
        "heuristic"
      ],
      "type": "string"
    }
  },
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "degradation": {
      "items": {
        "$ref": "#/definitions/DegradationKindV1"
      },
      "type": "array"
    },
    "evidence_admissibility": {
      "$ref": "#/definitions/EvidenceAdmissibilityV1"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "exactness": {
      "$ref": "#/definitions/ExactnessLevelV1"
    },
    "schema_version": {
      "type": "string"
    },
    "semantics_profile_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "stricter_check_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "witness_id": {
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "evidence_admissibility",
    "evidence_refs",
    "exactness",
    "schema_version",
    "semantics_profile_id",
    "statement",
    "witness_id"
  ],
  "title": "WitnessArtifactV1",
  "type": "object"
}
