{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SurfaceStatus": {
      "description": "Shared publication-status primitive for thin governance/profile surfaces.\n\nDomain crates may only use the variants they need, but they should not redefine the status family locally because that creates schema drift bait.",
      "enum": [
        "advisory_only",
        "non_admitted",
        "degraded",
        "horizon_only"
      ],
      "type": "string"
    }
  },
  "properties": {
    "canonical_owner": {
      "type": "string"
    },
    "publication_status": {
      "$ref": "#/definitions/SurfaceStatus"
    },
    "schema_version": {
      "type": "string"
    },
    "spec_bundle_id": {
      "type": "string"
    },
    "spec_name": {
      "type": "string"
    }
  },
  "required": [
    "canonical_owner",
    "publication_status",
    "schema_version",
    "spec_bundle_id",
    "spec_name"
  ],
  "title": "SpecBundleV1",
  "type": "object"
}
