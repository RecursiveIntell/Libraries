{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "advisory_only": {
      "type": "boolean"
    },
    "batch_id": {
      "type": "string"
    },
    "degradation_markers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "degraded_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_mode": {
      "type": "string"
    },
    "graph_hash": {
      "type": "string"
    },
    "iteration_count": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "message_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "oracle_mode": {
      "type": "string"
    },
    "oracle_supported": {
      "type": "boolean"
    },
    "satisfied_constraint_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "source_envelope_id": {
      "type": "string"
    }
  },
  "required": [
    "advisory_only",
    "batch_id",
    "degradation_markers",
    "execution_mode",
    "graph_hash",
    "iteration_count",
    "message_count",
    "oracle_mode",
    "oracle_supported",
    "satisfied_constraint_count",
    "source_envelope_id"
  ],
  "title": "InferenceAdvisoryV1",
  "type": "object"
}
