{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContentDigest": {
      "description": "A BLAKE3 content digest with explicit identity context.",
      "properties": {
        "hex": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/definitions/DigestMetadata"
        }
      },
      "required": [
        "hex",
        "metadata"
      ],
      "type": "object"
    },
    "DigestMetadata": {
      "description": "Identity context cryptographically bound into a content digest.",
      "properties": {
        "algorithm": {
          "description": "Hash algorithm.",
          "type": "string"
        },
        "canonicalization_profile": {
          "description": "Canonicalization algorithm/profile.",
          "type": "string"
        },
        "domain_separator": {
          "description": "Domain separator preventing cross-protocol reuse.",
          "type": "string"
        },
        "schema_id": {
          "description": "Schema identifier for the hashed value.",
          "type": "string"
        },
        "schema_version": {
          "description": "Schema version for the hashed value.",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "canonicalization_profile",
        "domain_separator",
        "schema_id",
        "schema_version"
      ],
      "type": "object"
    },
    "RegionArtifactKind": {
      "description": "Kind of artifact transported between compiled regions.",
      "enum": [
        "delta",
        "residual",
        "syndrome",
        "witness",
        "control_receipt",
        "nuisance_state",
        "oracle_parity"
      ],
      "type": "string"
    }
  },
  "description": "Transport record for an artifact crossing between compiled verification regions.",
  "properties": {
    "artifact_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "artifact_id": {
      "type": "string"
    },
    "artifact_kind": {
      "$ref": "#/definitions/RegionArtifactKind"
    },
    "from_region_id": {
      "type": "string"
    },
    "from_surface": {
      "type": "string"
    },
    "replay_ref": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "to_region_id": {
      "type": "string"
    },
    "to_surface": {
      "type": "string"
    },
    "transport_id": {
      "type": "string"
    }
  },
  "required": [
    "artifact_digest",
    "artifact_id",
    "artifact_kind",
    "from_region_id",
    "from_surface",
    "replay_ref",
    "schema_version",
    "to_region_id",
    "to_surface",
    "transport_id"
  ],
  "title": "RegionArtifactTransport",
  "type": "object"
}
