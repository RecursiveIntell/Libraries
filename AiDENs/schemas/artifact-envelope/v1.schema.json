{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactAuthorityClassV1": {
      "enum": [
        "canonical-owner-reference",
        "ai-d-e-ns-execution-authoritative",
        "ai-d-e-ns-display-only",
        "admitted-facade",
        "fixture-backed",
        "external-quarantine"
      ],
      "type": "string"
    },
    "ArtifactLifecycleStateV1": {
      "enum": [
        "created",
        "validated",
        "admitted",
        "projected",
        "proposed",
        "verified",
        "refuted",
        "contradicted",
        "quarantined",
        "promoted",
        "superseded",
        "retired",
        "subtracted",
        "disputed"
      ],
      "type": "string"
    },
    "CanonicalBackpointerV1": {
      "description": "AiDENs-local wrapper pointer to a canonical owner artifact or owner type.\n\nThis does not make AiDENs authoritative for the pointed-to concept; it records where a display/report DTO must be reconciled for canonical truth.",
      "properties": {
        "artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_crate": {
          "type": "string"
        },
        "owner_type": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "owner_crate",
        "owner_type",
        "role"
      ],
      "type": "object"
    },
    "DisplayDigestV1": {
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "canonicalization": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "non_authoritative": {
          "default": true,
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "type": "object"
    }
  },
  "properties": {
    "artifact_ref": {
      "type": "string"
    },
    "authority_class": {
      "$ref": "#/definitions/ArtifactAuthorityClassV1"
    },
    "bitemporal_applicability": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_backpointers": {
      "items": {
        "$ref": "#/definitions/CanonicalBackpointerV1"
      },
      "type": "array"
    },
    "content_digest": {
      "anyOf": [
        {
          "$ref": "#/definitions/DisplayDigestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_recorded_time": {
      "format": "date-time",
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/definitions/ArtifactLifecycleStateV1"
    },
    "namespace": {
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "signature_or_attestation_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact_ref",
    "authority_class",
    "created_recorded_time",
    "family",
    "issuer",
    "lifecycle_state",
    "namespace",
    "schema_version"
  ],
  "title": "ArtifactEnvelopeV1",
  "type": "object"
}
