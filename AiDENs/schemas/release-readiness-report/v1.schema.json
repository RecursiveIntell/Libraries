{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "ExampleAppEntryV1": {
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "example_id": {
          "type": "string"
        },
        "memory_mode": {
          "$ref": "#/definitions/MemoryModeV1"
        },
        "path": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "provider_kind": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/ReleaseSurfaceStateV1"
        }
      },
      "required": [
        "example_id",
        "memory_mode",
        "path",
        "profile_id",
        "provider_kind",
        "status"
      ],
      "type": "object"
    },
    "ExampleAppManifestV1": {
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/definitions/ExampleAppEntryV1"
          },
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ArtifactKindV1"
        },
        "manifest_id": {
          "type": "string"
        },
        "profiles_covered": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unsupported_advanced_features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "examples",
        "generated_at",
        "kind",
        "manifest_id",
        "profiles_covered",
        "unsupported_advanced_features"
      ],
      "type": "object"
    },
    "InstallSmokeReportV1": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/ArtifactKindV1"
        },
        "passed": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/InstallSmokeStepV1"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "passed",
        "receipt_id",
        "recorded_at",
        "steps"
      ],
      "type": "object"
    },
    "InstallSmokeStepV1": {
      "properties": {
        "command": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "output_digest",
        "passed",
        "step"
      ],
      "type": "object"
    },
    "MemoryModeV1": {
      "enum": [
        "disabled",
        "optional",
        "required"
      ],
      "type": "string"
    },
    "PublicDocFindingV1": {
      "properties": {
        "excerpt": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "surface_id": {
          "type": "string"
        }
      },
      "required": [
        "excerpt",
        "line",
        "path",
        "reason_code",
        "surface_id"
      ],
      "type": "object"
    },
    "ReleaseSurfaceStateV1": {
      "enum": [
        "supported",
        "partial",
        "deferred",
        "degraded",
        "blocked"
      ],
      "type": "string"
    },
    "ReleaseSurfaceV1": {
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/ReleaseSurfaceStateV1"
        },
        "surface_id": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "state",
        "surface_id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "example_manifest": {
      "$ref": "#/definitions/ExampleAppManifestV1"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "install_smoke": {
      "$ref": "#/definitions/InstallSmokeReportV1"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "public_doc_findings": {
      "items": {
        "$ref": "#/definitions/PublicDocFindingV1"
      },
      "type": "array"
    },
    "ready": {
      "type": "boolean"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "report_id": {
      "type": "string"
    },
    "surfaces": {
      "items": {
        "$ref": "#/definitions/ReleaseSurfaceV1"
      },
      "type": "array"
    }
  },
  "required": [
    "example_manifest",
    "generated_at",
    "install_smoke",
    "kind",
    "ready",
    "report_id",
    "surfaces"
  ],
  "title": "ReleaseReadinessReportV1",
  "type": "object"
}
