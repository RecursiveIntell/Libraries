{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "ExampleAppEntryV1": {
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "example_id": {
          "type": "string"
        },
        "memory_mode": {
          "$ref": "#/definitions/MemoryModeV1"
        },
        "path": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "provider_kind": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/ReleaseSurfaceStateV1"
        }
      },
      "required": [
        "example_id",
        "memory_mode",
        "path",
        "profile_id",
        "provider_kind",
        "status"
      ],
      "type": "object"
    },
    "MemoryModeV1": {
      "enum": [
        "disabled",
        "optional",
        "required"
      ],
      "type": "string"
    },
    "ReleaseSurfaceStateV1": {
      "enum": [
        "supported",
        "partial",
        "deferred",
        "degraded",
        "blocked"
      ],
      "type": "string"
    }
  },
  "properties": {
    "examples": {
      "items": {
        "$ref": "#/definitions/ExampleAppEntryV1"
      },
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "manifest_id": {
      "type": "string"
    },
    "profiles_covered": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unsupported_advanced_features": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "examples",
    "generated_at",
    "kind",
    "manifest_id",
    "profiles_covered",
    "unsupported_advanced_features"
  ],
  "title": "ExampleAppManifestV1",
  "type": "object"
}
