        "risk_class": {
          "$ref": "#/definitions/ToolSideEffectClass"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox_root": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "tool_id": {
