{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "SafeModeOperationV1": {
      "enum": [
        "entered",
        "exited",
        "blocked-risky-job",
        "drain-allowed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "affected_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "drain_allowed": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "inspection_allowed": {
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "namespace_id": {
      "type": "string"
    },
    "new_risky_jobs_blocked": {
      "type": "boolean"
    },
    "operation": {
      "$ref": "#/definitions/SafeModeOperationV1"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "drain_allowed",
    "enabled",
    "inspection_allowed",
    "kind",
    "namespace_id",
    "new_risky_jobs_blocked",
    "operation",
    "receipt_id",
    "recorded_at"
  ],
  "title": "SafeModeReportV1",
  "type": "object"
}
