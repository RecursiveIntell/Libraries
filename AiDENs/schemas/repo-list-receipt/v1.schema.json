{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "DisplayDigestV1": {
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "canonicalization": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "non_authoritative": {
          "default": true,
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "type": "object"
    },
    "RepoListEntryV1": {
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entry_kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "entry_kind",
        "path"
      ],
      "type": "object"
    }
  },
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "entries": {
      "items": {
        "$ref": "#/definitions/RepoListEntryV1"
      },
      "type": "array"
    },
    "full_listing_digest": {
      "anyOf": [
        {
          "$ref": "#/definitions/DisplayDigestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "listed_at": {
      "format": "date-time",
      "type": "string"
    },
    "listing_digest": {
      "$ref": "#/definitions/DisplayDigestV1"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "requested_path": {
      "type": "string"
    },
    "returned_entries": {
      "default": 0,
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "sandbox_root": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "total_entries": {
      "default": 0,
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "allowed",
    "entries",
    "kind",
    "listed_at",
    "listing_digest",
    "receipt_id",
    "requested_path",
    "sandbox_root",
    "tool_id"
  ],
  "title": "RepoListReportV1",
  "type": "object"
}
