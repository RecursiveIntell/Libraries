{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "JobStateV1": {
      "enum": [
        "queued",
        "leased",
        "running",
        "completed",
        "retrying",
        "cancelled",
        "poisoned"
      ],
      "type": "string"
    },
    "QueueHopKindV1": {
      "enum": [
        "enqueued",
        "lease-acquired",
        "lease-stolen",
        "executed",
        "retried",
        "cancelled",
        "duplicate-suppressed",
        "safe-mode-blocked",
        "drained",
        "poisoned"
      ],
      "type": "string"
    }
  },
  "properties": {
    "from_state": {
      "anyOf": [
        {
          "$ref": "#/definitions/JobStateV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "hop": {
      "$ref": "#/definitions/QueueHopKindV1"
    },
    "job_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "namespace_id": {
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "to_state": {
      "$ref": "#/definitions/JobStateV1"
    }
  },
  "required": [
    "hop",
    "job_id",
    "kind",
    "namespace_id",
    "receipt_id",
    "recorded_at",
    "to_state"
  ],
  "title": "QueueHopReportV1",
  "type": "object"
}
