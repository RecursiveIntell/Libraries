{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "DisplayDigestV1": {
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "canonicalization": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "non_authoritative": {
          "default": true,
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "type": "object"
    }
  },
  "properties": {
    "diff_digest": {
      "$ref": "#/definitions/DisplayDigestV1"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "mutates_files": {
      "type": "boolean"
    },
    "proposal_id": {
      "type": "string"
    },
    "proposed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "touched_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unified_diff": {
      "type": "string"
    }
  },
  "required": [
    "diff_digest",
    "kind",
    "mutates_files",
    "proposal_id",
    "proposed_at",
    "summary",
    "touched_paths",
    "unified_diff"
  ],
  "title": "PatchProposalV1",
  "type": "object"
}
