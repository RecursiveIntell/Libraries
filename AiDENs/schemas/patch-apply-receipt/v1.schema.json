{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactKindV1": {
      "description": "AiDENs-local display discriminator; not a canonical artifact family schema.",
      "type": "string"
    },
    "DisplayDigestV1": {
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "canonicalization": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "non_authoritative": {
          "default": true,
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "type": "object"
    }
  },
  "properties": {
    "after_digests": {
      "additionalProperties": {
        "$ref": "#/definitions/DisplayDigestV1"
      },
      "type": "object"
    },
    "applied": {
      "type": "boolean"
    },
    "applied_at": {
      "format": "date-time",
      "type": "string"
    },
    "before_digests": {
      "additionalProperties": {
        "$ref": "#/definitions/DisplayDigestV1"
      },
      "type": "object"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dry_run_checked": {
      "default": false,
      "type": "boolean"
    },
    "failure_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_digest": {
      "$ref": "#/definitions/DisplayDigestV1"
    },
    "kind": {
      "$ref": "#/definitions/ArtifactKindV1"
    },
    "permit_grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "permit_use_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "rollback_advice": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sandbox_root": {
      "type": "string"
    },
    "semantic_status": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "touched_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "after_digests",
    "applied",
    "applied_at",
    "before_digests",
    "input_digest",
    "kind",
    "receipt_id",
    "sandbox_root",
    "tool_id",
    "touched_paths"
  ],
  "title": "PatchApplyReportV1",
  "type": "object"
}
