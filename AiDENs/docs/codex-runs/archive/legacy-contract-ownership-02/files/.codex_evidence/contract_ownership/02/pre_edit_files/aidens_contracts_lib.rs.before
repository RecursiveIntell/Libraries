    }

    #[test]
    fn p17_attestation_admission_and_settlement_constructors_are_typed() {
        let trust_root = TrustRootV1::active(
            "remote-a",
            "public-key-material",
            "claims",
            "admit-verified-v1",
        );
        let envelope = AttestationEnvelopeV1::new(
            ArtifactId("claim:remote-a".into()),
            "remote-a",
            "claim-record",
            1,
            "admit-verified-v1",
            serde_json::json!({"subject":"repo","predicate":"status","object":"ready"}),
        )
        .signed(
            trust_root.trust_root_id.clone(),
            "ed25519-test",
            "signature:test",
        );
        let decision = AdmissionDecisionV1::from_envelope(
            &envelope,
            AdmissionDispositionV1::Accept,
            "unit-test",
            vec!["verified-trust-root".into()],
        );
        let oracle = RemoteOracleReportV1::imported(&envelope, &decision);
        let treaty = TreatyV1::new(
            "local",
            "remote-a",
            "claims",
            "local-authority-first",
            vec![trust_root.trust_root_id.clone()],
        );
        let settlement = SettlementCaseV1::disputed(
            ArtifactId("claim:local".into()),
            &envelope,
            decision.decision_id.clone(),
            Some(treaty.treaty_id.clone()),
            "remote-claim-conflicts-with-local-claim",
        );
        let shared = SharedDispositionV1::local_preserved(
            settlement.case_id.clone(),
            CanonicalVerificationDisposition::DegradedNoPromotion,
            AdmissionDispositionV1::Downgrade,
            vec!["local".into(), "remote-a".into()],
        );
        let settled = settlement.settle(shared.disposition_id.clone());
        let revoked = trust_root.revoke(vec![envelope.envelope_id.clone()], "key-rotated");

        assert_eq!(envelope.kind, ArtifactKindV1::AttestationEnvelope);
        assert!(envelope.is_signed_and_verified());
        assert_eq!(decision.kind, ArtifactKindV1::AdmissionDecision);
        assert!(decision.permits_import(&envelope));
        assert_eq!(oracle.kind, ArtifactKindV1::RemoteOracleReport);
        assert!(oracle.imported);
        assert!(!oracle.locally_promoted);
        assert_eq!(treaty.kind, ArtifactKindV1::Treaty);
        assert_eq!(settled.kind, ArtifactKindV1::SettlementCase);
        assert!(settled.direct_overwrite_prevented);
        assert_eq!(shared.kind, ArtifactKindV1::SharedDisposition);
        assert!(shared.local_authority_preserved);
        assert_eq!(revoked.status, TrustRootStatusV1::Revoked);
        assert!(revoked
            .reason_codes
            .contains(&"trust-root-revocation-downgrades-artifacts".into()));
    }

    #[test]
    fn p17_golden_fixtures_deserialize() {
        let envelope = include_str!("../../../tests/fixtures/p17/attestation_envelope_v1.json");
        let envelope: AttestationEnvelopeV1 = serde_json::from_str(envelope).unwrap();
