        assert_eq!(shared.kind, ArtifactKindV1::SharedDisposition);
        assert!(shared.local_authority_preserved);
    }

    #[test]
    fn p18_mechanism_artifacts_keep_fit_refuter_and_alias_law_explicit() {
        let simulator = SimulatorContractV1::new(
            "linear-simulator",
            "deterministic-rust",
            serde_json::json!({"type":"object","required":["x"]}),
            serde_json::json!({"type":"object","required":["y"]}),
            vec![
                "cargo".into(),
                "run".into(),
                "--example".into(),
                "sim".into(),
            ],
        );
        let mechanism = MechanismReportV1::new(
            MechanismReportDraftV1::new(
                MechanismKindV1::Symbolic,
                "linear-response",
                "v1",
                "cargo run --example sim -- --seed 7",
            )
            .with_variables(vec!["x".into(), "y".into()])
            .with_assumptions(vec!["no-hidden-confounder".into()])
            .with_causal_claims(vec!["x-causes-y".into()])
            .with_program(vec!["y = alpha * x + beta".into()])
            .with_parameters(BTreeMap::from([("alpha".into(), serde_json::json!(1.0))])),
        )
        .with_simulator_contract(simulator.contract_id.clone())
        .with_raw_weight_digest("sha256:weights-are-not-the-artifact");
        let theory = TheoryVersionV1::candidate(
            mechanism.mechanism_id.clone(),
            1,
            "linear response theory",
            "x shifts y under intervention",
        );
        let fit = FitRunReportV1::new(
            mechanism.mechanism_id.clone(),
            Some(simulator.contract_id.clone()),
            serde_json::json!({"rows": 12}),
            serde_json::json!({"alpha": 1.0}),
            serde_json::json!({"loss": 0.01}),
            "least-squares",
            Some(0.99),
        )
        .for_theory(theory.theory_id.clone())
        .with_seed(7)
        .with_replay_command(simulator.replay_command.clone());
        let invariance = InvarianceReportV1::new(
            mechanism.mechanism_id.clone(),
            Some(theory.theory_id.clone()),
            Some(fit.receipt_id.clone()),
            vec![InvarianceCheckV1::new("shift-x", "lab", "x+1", 0.0, 0.01)],
        );
        let refuters = TheoryRefuterSuiteV1::new(
            theory.theory_id.clone(),
            mechanism.mechanism_id.clone(),
            vec![ArtifactId("refuter:intervention-shift".into())],
            vec![fit.receipt_id.clone()],
            vec![invariance.report_id.clone()],
            TheoryRefuterOutcomeV1::NoRefutationFound,
        )
        .with_replay_handles(vec![fit.receipt_id.clone()]);
        let published = theory
            .clone()
            .fitted(fit.receipt_id.clone(), Some(invariance.report_id.clone()))
            .published(
                refuters.suite_id.clone(),
                ArtifactId("promotion-decision:theory".into()),
                ArtifactId("control-receipt:theory".into()),
            );
        let sibling = MechanismReportV1::new(
            MechanismReportDraftV1::new(
                MechanismKindV1::Symbolic,
                "linear-response-reparameterized",
                "v1",
                "cargo run --example sim -- --seed 7 --basis centered",
            )
            .with_variables(vec!["x".into(), "y".into()])
            .with_assumptions(vec!["no-hidden-confounder".into()])
            .with_causal_claims(vec!["x-causes-y".into()])
            .with_program(vec!["y = gamma * (x - x0) + beta".into()]),
        );
        let library = HypothesisLibraryV1::new(
            "p18-library",
            vec![published.theory_id.clone()],
            vec![mechanism.mechanism_id.clone(), sibling.mechanism_id.clone()],
        )
        .with_equivalence_decision(MechanismEquivalenceDecisionV1::distinct(
            mechanism.mechanism_id.clone(),
            sibling.mechanism_id.clone(),
            true,
        ));
        let aliased = library.clone().with_equivalence_decision(
            MechanismEquivalenceDecisionV1::alias_admitted(
                mechanism.mechanism_id.clone(),
                sibling.mechanism_id.clone(),
                ArtifactId("admission-decision:alias".into()),
            ),
        );

        assert_eq!(mechanism.kind, ArtifactKindV1::MechanismReport);
        assert!(mechanism.is_replayable());
        assert!(simulator.is_replayable());
        assert_eq!(fit.kind, ArtifactKindV1::FitRunReport);
        assert!(fit.is_replayable());
        assert!(!fit.score_is_verification);
        assert_eq!(invariance.kind, ArtifactKindV1::InvarianceReport);
        assert!(!invariance.supports_causal_identification());
        assert!(refuters.satisfies_promotion_bar());
        assert_eq!(published.state, TheoryVersionStateV1::Published);
        assert!(published.has_governance_basis());
        assert!(library.mechanisms_remain_distinct(&mechanism.mechanism_id, &sibling.mechanism_id));
        assert!(aliased.mechanisms_should_merge(&mechanism.mechanism_id, &sibling.mechanism_id));
    }

    #[test]
    fn p18_golden_fixtures_deserialize() {
        let mechanism = include_str!("../../../tests/fixtures/p18/mechanism_bundle_v1.json");
        let mechanism: MechanismReportV1 = serde_json::from_str(mechanism).unwrap();
