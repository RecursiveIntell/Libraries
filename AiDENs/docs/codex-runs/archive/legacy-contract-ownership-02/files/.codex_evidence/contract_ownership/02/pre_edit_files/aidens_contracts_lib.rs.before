#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct CanonicalDigestV1 {
    pub algorithm: String,
    pub canonicalization: String,
    pub digest: String,
}

impl CanonicalDigestV1 {
    pub fn for_json_value(value: &serde_json::Value) -> Self {
        Self {
            algorithm: "sha256".into(),
            canonicalization: "aidens-json-c14n-v1".into(),
            digest: stable_json_digest(value),
        }
    }

    pub fn for_text(text: &str) -> Self {
        Self {
            algorithm: "sha256".into(),
            canonicalization: "utf8-text-v1".into(),
            digest: stable_text_digest(text),
        }
    }

    pub fn for_stack_content_digest(
        digest: StackContentDigest,
        canonicalization: impl Into<String>,
    ) -> Self {
        Self {
            algorithm: "blake3".into(),
            canonicalization: canonicalization.into(),
            digest: digest.hex().to_string(),
        }
    }

    pub fn as_stack_content_digest(&self) -> Result<StackContentDigest, String> {
        if self.algorithm != "blake3" {
            return Err(format!(
                "canonical stack digest requires blake3, found {}",
                self.algorithm
            ));
        }
        StackContentDigest::from_hex(self.digest.trim_start_matches("blake3:"))
            .map_err(|error| error.to_string())
    }
}

