#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
#[serde(rename_all = "kebab-case")]
pub enum AttestationVerificationStatusV1 {
    Verified,
    Unsigned,
    UnknownTrustRoot,
    SignatureInvalid,
    ProducerRevoked,
    SchemaUnsupported,
}

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
pub struct AttestationEnvelopeV1 {
    pub envelope_id: ArtifactId,
    pub kind: ArtifactKindV1,
    pub subject_artifact_id: ArtifactId,
    pub subject_digest: CanonicalDigestV1,
    pub producer_id: String,
    pub schema_family: String,
    pub schema_version: u32,
    pub policy_id: String,
    pub issued_at: DateTime<Utc>,
    pub expires_at: Option<DateTime<Utc>>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub trust_root_id: Option<ArtifactId>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub signature_algorithm: Option<String>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub signature: Option<String>,
    pub verification_status: AttestationVerificationStatusV1,
    pub truth_bearing: bool,
    pub body: serde_json::Value,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
}

impl AttestationEnvelopeV1 {
    pub fn new(
        subject_artifact_id: ArtifactId,
        producer_id: impl Into<String>,
        schema_family: impl Into<String>,
        schema_version: u32,
        policy_id: impl Into<String>,
        body: serde_json::Value,
    ) -> Self {
        let subject_digest = CanonicalDigestV1::for_json_value(&body);
        Self {
            envelope_id: generated_artifact_id("attestation-envelope"),
            kind: ArtifactKindV1::AttestationEnvelope,
            subject_artifact_id,
            subject_digest,
            producer_id: producer_id.into(),
            schema_family: schema_family.into(),
            schema_version,
            policy_id: policy_id.into(),
            issued_at: Utc::now(),
            expires_at: None,
            trust_root_id: None,
            signature_algorithm: None,
            signature: None,
            verification_status: AttestationVerificationStatusV1::Unsigned,
            truth_bearing: true,
            body,
            reason_codes: vec!["attestation-envelope-created".into()],
        }
    }

    pub fn signed(
        mut self,
        trust_root_id: ArtifactId,
        signature_algorithm: impl Into<String>,
        signature: impl Into<String>,
    ) -> Self {
        self.trust_root_id = Some(trust_root_id);
        self.signature_algorithm = Some(signature_algorithm.into());
        self.signature = Some(signature.into());
        self.verification_status = AttestationVerificationStatusV1::Verified;
        self.reason_codes.push("signature-verified".into());
        self.reason_codes.sort();
        self.reason_codes.dedup();
        self
    }

    pub fn verification_failed(
        mut self,
        status: AttestationVerificationStatusV1,
        reason: impl Into<String>,
    ) -> Self {
        self.verification_status = status;
        self.reason_codes.push(reason.into());
        self.reason_codes.sort();
        self.reason_codes.dedup();
        self
    }

    pub fn is_signed_and_verified(&self) -> bool {
        self.verification_status == AttestationVerificationStatusV1::Verified
            && self.trust_root_id.is_some()
            && self.signature.is_some()
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
#[serde(rename_all = "kebab-case")]
pub enum TrustRootStatusV1 {
    Active,
    Revoked,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct TrustRootV1 {
    pub trust_root_id: ArtifactId,
    pub kind: ArtifactKindV1,
    pub producer_id: String,
    pub public_key_digest: String,
    pub status: TrustRootStatusV1,
    pub federation_scope: String,
    pub admission_policy_id: String,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub revoked_at: Option<DateTime<Utc>>,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub affected_envelope_ids: Vec<ArtifactId>,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
}

impl TrustRootV1 {
    pub fn active(
        producer_id: impl Into<String>,
        public_key_material: impl AsRef<str>,
        federation_scope: impl Into<String>,
        admission_policy_id: impl Into<String>,
    ) -> Self {
        Self {
            trust_root_id: generated_artifact_id("trust-root"),
            kind: ArtifactKindV1::TrustRoot,
            producer_id: producer_id.into(),
            public_key_digest: stable_text_digest(public_key_material.as_ref()),
            status: TrustRootStatusV1::Active,
            federation_scope: federation_scope.into(),
            admission_policy_id: admission_policy_id.into(),
            created_at: Utc::now(),
            updated_at: Utc::now(),
            revoked_at: None,
            affected_envelope_ids: Vec::new(),
            reason_codes: vec!["trust-root-active".into()],
        }
    }

    pub fn revoke(
        mut self,
        affected_envelope_ids: Vec<ArtifactId>,
        reason: impl Into<String>,
    ) -> Self {
        self.status = TrustRootStatusV1::Revoked;
        self.updated_at = Utc::now();
        self.revoked_at = Some(self.updated_at);
        self.affected_envelope_ids = affected_envelope_ids;
        self.reason_codes.push(reason.into());
        self.reason_codes
            .push("trust-root-revocation-downgrades-artifacts".into());
        self.reason_codes.sort();
        self.reason_codes.dedup();
        self
    }

    pub fn is_active(&self) -> bool {
        self.status == TrustRootStatusV1::Active
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
#[serde(rename_all = "kebab-case")]
pub enum AdmissionDispositionV1 {
    Accept,
    Quarantine,
    Downgrade,
    Reject,
    RequireAdditionalWitness,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct AdmissionDecisionV1 {
    pub decision_id: ArtifactId,
    pub kind: ArtifactKindV1,
    pub envelope_id: ArtifactId,
    pub subject_artifact_id: ArtifactId,
    pub subject_digest: CanonicalDigestV1,
    pub producer_id: String,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub trust_root_id: Option<ArtifactId>,
    pub disposition: AdmissionDispositionV1,
    pub import_allowed: bool,
    pub advisory_only: bool,
    pub local_promotion_required: bool,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub required_witnesses: Vec<String>,
    pub decided_by: String,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
    pub decided_at: DateTime<Utc>,
}

impl AdmissionDecisionV1 {
    pub fn from_envelope(
        envelope: &AttestationEnvelopeV1,
        disposition: AdmissionDispositionV1,
        decided_by: impl Into<String>,
        mut reason_codes: Vec<String>,
    ) -> Self {
        let import_allowed = matches!(
            disposition,
            AdmissionDispositionV1::Accept
                | AdmissionDispositionV1::Quarantine
                | AdmissionDispositionV1::Downgrade
        );
        let advisory_only = !matches!(disposition, AdmissionDispositionV1::Accept);
        if !import_allowed {
            reason_codes.push("external-artifact-import-blocked".into());
        }
        if advisory_only {
            reason_codes.push("external-artifact-advisory-only".into());
        }
        reason_codes.push("admission-decision-required-before-import".into());
        reason_codes.sort();
        reason_codes.dedup();
        Self {
            decision_id: generated_artifact_id("admission-decision"),
            kind: ArtifactKindV1::AdmissionDecision,
            envelope_id: envelope.envelope_id.clone(),
            subject_artifact_id: envelope.subject_artifact_id.clone(),
            subject_digest: envelope.subject_digest.clone(),
            producer_id: envelope.producer_id.clone(),
            trust_root_id: envelope.trust_root_id.clone(),
            disposition,
            import_allowed,
            advisory_only,
            local_promotion_required: true,
            required_witnesses: Vec::new(),
            decided_by: decided_by.into(),
            reason_codes,
            decided_at: Utc::now(),
        }
    }

    pub fn requiring_witness(
        envelope: &AttestationEnvelopeV1,
        decided_by: impl Into<String>,
        witnesses: Vec<String>,
        reason: impl Into<String>,
    ) -> Self {
        let mut decision = Self::from_envelope(
            envelope,
            AdmissionDispositionV1::RequireAdditionalWitness,
            decided_by,
            vec![reason.into()],
        );
        decision.required_witnesses = witnesses;
        decision
    }

    pub fn permits_import(&self, envelope: &AttestationEnvelopeV1) -> bool {
        self.import_allowed
            && self.envelope_id == envelope.envelope_id
            && self.subject_digest == envelope.subject_digest
    }
}

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema)]
pub struct RemoteOracleReportV1 {
    pub receipt_id: ArtifactId,
    pub kind: ArtifactKindV1,
    pub envelope_id: ArtifactId,
    pub admission_decision_id: ArtifactId,
    pub subject_artifact_id: ArtifactId,
    pub subject_digest: CanonicalDigestV1,
    pub advisory_only: bool,
    pub imported: bool,
    pub locally_promoted: bool,
    pub oracle_payload: serde_json::Value,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
    pub recorded_at: DateTime<Utc>,
}

impl RemoteOracleReportV1 {
    pub fn imported(envelope: &AttestationEnvelopeV1, decision: &AdmissionDecisionV1) -> Self {
        let imported = decision.permits_import(envelope);
        let mut reason_codes = vec!["remote-oracle-import-is-advisory".into()];
        if imported {
            reason_codes.push("external-artifact-imported-through-admission-decision".into());
        } else {
            reason_codes.push("external-artifact-not-imported".into());
        }
        Self {
            receipt_id: generated_artifact_id("remote-oracle-report"),
            kind: ArtifactKindV1::RemoteOracleReport,
            envelope_id: envelope.envelope_id.clone(),
            admission_decision_id: decision.decision_id.clone(),
            subject_artifact_id: envelope.subject_artifact_id.clone(),
            subject_digest: envelope.subject_digest.clone(),
            advisory_only: decision.advisory_only || decision.local_promotion_required,
            imported,
            locally_promoted: false,
            oracle_payload: envelope.body.clone(),
            reason_codes,
            recorded_at: Utc::now(),
        }
    }

    pub fn not_imported(envelope: &AttestationEnvelopeV1, decision: &AdmissionDecisionV1) -> Self {
        let mut receipt = Self::imported(envelope, decision);
        receipt.imported = false;
        receipt
            .reason_codes
            .push("remote-oracle-import-denied".into());
        receipt.reason_codes.sort();
        receipt.reason_codes.dedup();
        receipt
    }
}

