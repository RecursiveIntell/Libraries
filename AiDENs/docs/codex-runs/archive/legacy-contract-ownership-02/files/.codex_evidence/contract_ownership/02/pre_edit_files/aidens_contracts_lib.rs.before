#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct PoisonReportEntryV1 {
    pub poison_id: ArtifactId,
    pub source_path: String,
    pub line_number: u64,
    pub raw_digest: String,
    pub raw_line: String,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
    pub recorded_at: DateTime<Utc>,
}

impl PoisonReportEntryV1 {
    pub fn new(
        source_path: impl Into<String>,
        line_number: u64,
        raw_line: impl Into<String>,
        reason: impl Into<String>,
    ) -> Self {
        let raw_line = raw_line.into();
        Self {
            poison_id: generated_artifact_id("poison-receipt"),
            source_path: source_path.into(),
            line_number,
            raw_digest: stable_json_digest(&serde_json::Value::String(raw_line.clone())),
            raw_line,
            reason_codes: vec![reason.into()],
            recorded_at: Utc::now(),
        }
    }
}

