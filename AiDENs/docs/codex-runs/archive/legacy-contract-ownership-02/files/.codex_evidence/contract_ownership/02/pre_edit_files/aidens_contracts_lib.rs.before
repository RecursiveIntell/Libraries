#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct SettlementCaseV1 {
    pub case_id: ArtifactId,
    pub kind: ArtifactKindV1,
    pub local_claim_id: ArtifactId,
    pub remote_subject_artifact_id: ArtifactId,
    pub remote_envelope_id: ArtifactId,
    pub admission_decision_id: ArtifactId,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub treaty_id: Option<ArtifactId>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub shared_disposition_id: Option<ArtifactId>,
    pub state: SettlementStateV1,
    pub local_authority_preserved: bool,
    pub direct_overwrite_prevented: bool,
    #[serde(default, skip_serializing_if = "Vec::is_empty")]
    pub reason_codes: Vec<String>,
    pub opened_at: DateTime<Utc>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub resolved_at: Option<DateTime<Utc>>,
}

impl SettlementCaseV1 {
    pub fn disputed(
        local_claim_id: ArtifactId,
        envelope: &AttestationEnvelopeV1,
        admission_decision_id: ArtifactId,
        treaty_id: Option<ArtifactId>,
        reason: impl Into<String>,
    ) -> Self {
        Self {
            case_id: generated_artifact_id("settlement-case"),
            kind: ArtifactKindV1::SettlementCase,
            local_claim_id,
            remote_subject_artifact_id: envelope.subject_artifact_id.clone(),
            remote_envelope_id: envelope.envelope_id.clone(),
            admission_decision_id,
            treaty_id,
            shared_disposition_id: None,
            state: SettlementStateV1::Disputed,
            local_authority_preserved: true,
            direct_overwrite_prevented: true,
            reason_codes: vec![
                reason.into(),
                "remote-contradiction-opened-settlement-case".into(),
                "local-truth-not-overwritten".into(),
            ],
            opened_at: Utc::now(),
            resolved_at: None,
        }
    }

    pub fn settle(mut self, shared_disposition_id: ArtifactId) -> Self {
        self.shared_disposition_id = Some(shared_disposition_id);
        self.state = SettlementStateV1::Settled;
        self.resolved_at = Some(Utc::now());
        self.reason_codes
            .push("settlement-disposition-recorded".into());
        self.reason_codes.sort();
        self.reason_codes.dedup();
        self
    }
}

