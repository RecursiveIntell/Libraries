//! Versioned base contracts for AiDENs.
//!
//! This crate defines shared primitive artifact shapes. Semantic crates own
//! their deeper behavior; this crate prevents duplicate wire-visible types.

use chrono::{DateTime, Duration, Utc};
use schemars::JsonSchema;
use serde::{Deserialize, Serialize};
use sha2::{Digest, Sha256};
use std::collections::{BTreeMap, BTreeSet};
use std::fmt::{self, Write as _};
use uuid::Uuid;

/// Canonical identity and digest surfaces from the shared stack.
///
/// AiDENs re-exports the real stack ID crate. App-only constructors that need a
/// generated display ID use `generated_artifact_id`.
pub mod canonical_stack {
    pub use kernel_execution::{
        ExecutionReport as CanonicalKernelExecutionReport,
        ExecutionStopReason as CanonicalKernelStopReason,
    };
    pub use kernel_oracles::OracleAssessment as CanonicalOracleAssessment;
    pub use llm_tool_runtime::ToolSideEffectClass as CanonicalToolSideEffectClass;
    pub use recursive_kernel_core::KernelRun as CanonicalKernelRun;
    pub use semantic_memory_forge::{
        EpisodeBundleV1 as ForgeEpisodeBundleV1, ExecutionContextV1 as ForgeExecutionContextV1,
    };
    pub use stack_ids::{
        ArtifactId, AttemptId, ClaimId, ClaimVersionId, ContentDigest, DigestBuilder, EnvelopeId,
        EpisodeId, ImportBatchId, KernelRunId, ProjectionId, Scope, ScopeKey, TraceCtx, TrialId,
    };
    pub use verification_adjudication::VerificationDisposition as CanonicalVerificationDisposition;
    pub use verification_control::{
        BoundaryRepairRecord as CanonicalBoundaryRepairRecord,
        CheckPlan as CanonicalVerificationPlan, ControlReceipt as CanonicalControlReceipt,
        VerificationCase as CanonicalVerificationCase,
    };

    pub fn digest_json(value: &serde_json::Value) -> Result<ContentDigest, stack_ids::DigestError> {
        ContentDigest::compute_json(value)
    }
}

pub use canonical_stack::CanonicalVerificationDisposition;
pub use canonical_stack::{
    ArtifactId, ArtifactId as StackArtifactId, AttemptId as StackAttemptId,
    CanonicalKernelStopReason, CanonicalToolSideEffectClass, ClaimId as StackClaimId,
    ClaimVersionId as StackClaimVersionId, ContentDigest as StackContentDigest,
    DigestBuilder as StackDigestBuilder, EnvelopeId as StackEnvelopeId,
    EpisodeId as StackEpisodeId, ImportBatchId as StackImportBatchId,
    KernelRunId as StackKernelRunId, ProjectionId as StackProjectionId, Scope as StackScope,
    ScopeKey as StackScopeKey, TraceCtx as StackTraceCtx, TrialId as StackTrialId,
};

pub fn generated_artifact_id(prefix: &str) -> ArtifactId {
    ArtifactId::new(format!("{prefix}:{}", Uuid::new_v4()))
}

fn json_digest(value: &serde_json::Value) -> String {
    stable_json_digest(value)
}

pub fn stable_json_digest(value: &serde_json::Value) -> String {
    let normalized = canonical_json_string(value);
    stable_text_digest(&normalized)
}

pub fn stable_text_digest(text: &str) -> String {
    let digest = Sha256::digest(text.as_bytes());
    let mut encoded = String::with_capacity("sha256:".len() + 64);
    encoded.push_str("sha256:");
    for byte in digest {
        let _ = write!(&mut encoded, "{byte:02x}");
    }
    encoded
}

pub fn deterministic_artifact_id(prefix: &str, material: &str) -> ArtifactId {
    let digest = stable_text_digest(material);
    ArtifactId(format!(
        "{}:{}",
        prefix,
        digest.strip_prefix("sha256:").unwrap_or(&digest)
    ))
}

pub fn canonical_json_string(value: &serde_json::Value) -> String {
    let canonical = canonical_json_value(value);
    serde_json::to_string(&canonical).unwrap_or_default()
}

fn canonical_json_value(value: &serde_json::Value) -> serde_json::Value {
    match value {
        serde_json::Value::Array(items) => {
            serde_json::Value::Array(items.iter().map(canonical_json_value).collect())
        }
        serde_json::Value::Object(map) => {
            let mut canonical = serde_json::Map::new();
            let mut keys = map.keys().collect::<Vec<_>>();
            keys.sort();
            for key in keys {
                if let Some(child) = map.get(key) {
                    canonical.insert(key.clone(), canonical_json_value(child));
                }
            }
            serde_json::Value::Object(canonical)
        }
        serde_json::Value::Null
        | serde_json::Value::Bool(_)
        | serde_json::Value::Number(_)
        | serde_json::Value::String(_) => value.clone(),
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
#[serde(rename_all = "kebab-case")]
pub enum ArtifactVersion {
    V1,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
pub struct AidensRunContextV1 {
    pub run_id: ArtifactId,
    pub trace_id: ArtifactId,
    pub attempt_family_id: ArtifactId,
    pub attempt_id: ArtifactId,
    pub started_at: DateTime<Utc>,
    pub app_id: String,
    pub config_generation: Option<String>,
}

impl AidensRunContextV1 {
    pub fn new(app_id: impl Into<String>) -> Self {
        Self {
            run_id: generated_artifact_id("run"),
            trace_id: generated_artifact_id("trace"),
            attempt_family_id: generated_artifact_id("attempt-family"),
            attempt_id: generated_artifact_id("attempt"),
            started_at: Utc::now(),
            app_id: app_id.into(),
            config_generation: None,
        }
    }

    pub fn stack_trace_ctx(&self) -> StackTraceCtx {
        StackTraceCtx::from_trace_id(self.trace_id.0.clone())
    }

    pub fn stack_attempt_id(&self) -> StackAttemptId {
        StackAttemptId::new(self.attempt_id.0.clone())
    }
}

