            global_recompute_required: true,
            reason_codes: vec!["canonical-repair-required".into()],
            emitted_at: Utc::now(),
        }
    }

    pub fn requires_canonical_repair(&self) -> bool {
        self.global_recompute_required && self.canonical_repair_record_ids.is_empty()
    }
