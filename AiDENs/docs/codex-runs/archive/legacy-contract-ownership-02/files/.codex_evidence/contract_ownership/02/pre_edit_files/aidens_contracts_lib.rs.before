        let duplicate = include_str!("../../../tests/fixtures/p06/duplicate_key_finding_v1.json");
        let duplicate: DuplicateKeyFindingV1 = serde_json::from_str(duplicate).unwrap();
        assert_eq!(duplicate.key, "path");

