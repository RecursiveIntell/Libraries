-                    }
-                }
-
-                if stop_flag_thread.load(Ordering::SeqCst) {
-                    break;
-                }
-                tokio::time::sleep(tokio::time::Duration::from_secs(interval_secs)).await;
-            }
-        });
-
-        halt_flag_thread.halt();
-    });
-
-    Ok(ActiveLoop {
-        stop_flag,
-        halt_flag,
-        status,
-        join_handle: Some(join_handle),
