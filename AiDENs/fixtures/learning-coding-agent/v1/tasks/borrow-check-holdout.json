{
  "checks": [
    "cargo test --locked",
    "cargo fmt --check"
  ],
  "family": "borrow-check",
  "forbidden_effects": [
    "network",
    "filesystem outside fixture",
    "process spawning",
    "secret access"
  ],
  "id": "borrow-check-holdout",
  "language": "rust",
  "permitted_effects": [
    "edit fixture source only"
  ],
  "prompt": "Apply the minimal safe fix for borrow-check; preserve baseline behavior.",
  "split": "holdout",
  "toolchain": "1.86.0"
}
