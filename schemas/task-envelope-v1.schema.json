{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/definitions/ContentDigest"
        },
        "media_type": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "ContentDigest": {
      "description": "A BLAKE3 content digest for idempotent deduplication.\n\nThe inner value is a 64-character hex string representing the BLAKE3 hash.",
      "type": "string"
    },
    "ResourceLimitsV1": {
      "additionalProperties": false,
      "properties": {
        "max_artifacts": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_input_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_output_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_runtime_secs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "max_artifacts",
        "max_input_bytes",
        "max_output_bytes",
        "max_runtime_secs"
      ],
      "type": "object"
    }
  },
  "properties": {
    "capability_manifest_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "capability_manifest_id": {
      "type": "string"
    },
    "graph_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "graph_id": {
      "type": "string"
    },
    "graph_version": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/definitions/ArtifactRefV1"
      },
      "type": "array"
    },
    "owner_agent_id": {
      "type": "string"
    },
    "producer_agent_id": {
      "type": "string"
    },
    "request_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "resource_limits": {
      "$ref": "#/definitions/ResourceLimitsV1"
    },
    "schema_version": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "capability_manifest_digest",
    "capability_manifest_id",
    "graph_digest",
    "graph_id",
    "graph_version",
    "idempotency_key",
    "input_artifacts",
    "owner_agent_id",
    "producer_agent_id",
    "request_digest",
    "resource_limits",
    "schema_version",
    "submitted_at",
    "task_id"
  ],
  "title": "TaskEnvelopeV1",
  "type": "object"
}
