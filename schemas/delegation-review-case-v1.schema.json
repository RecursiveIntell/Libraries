{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConstitutionalContextStatus": {
      "description": "Completeness status of the constitutional context payload on a review artifact.",
      "enum": [
        "missing",
        "partial",
        "complete"
      ],
      "type": "string"
    },
    "DelegationReviewDecisionStateV1": {
      "description": "Terminal decision state of a delegation review case.",
      "enum": [
        "approved",
        "valid",
        "denied",
        "blocked"
      ],
      "type": "string"
    }
  },
  "description": "A review case for authority delegation decisions.\n\nValidates that delegation chains and separation-of-duties policies are satisfied before approving delegated authority.",
  "properties": {
    "applicability_context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_chain_id": {
      "type": "string"
    },
    "blocking_obligation_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "citation_status": {
      "$ref": "#/definitions/ConstitutionalContextStatus"
    },
    "compiled_obligation_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "composition_conflict_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "composition_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_state": {
      "$ref": "#/definitions/DelegationReviewDecisionStateV1"
    },
    "delegation_review_case_id": {
      "type": "string"
    },
    "effective_constitution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "monitoring_obligation_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "obligation_refs_status": {
      "$ref": "#/definitions/ConstitutionalContextStatus"
    },
    "profile_exception_bundle_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_obligation_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "separation_of_duties_policy_id": {
      "type": "string"
    }
  },
  "required": [
    "authority_chain_id",
    "citation_status",
    "decision_state",
    "delegation_review_case_id",
    "generated_at",
    "obligation_refs_status",
    "schema_version",
    "separation_of_duties_policy_id"
  ],
  "title": "DelegationReviewCaseV1",
  "type": "object"
}
