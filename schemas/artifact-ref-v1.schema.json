  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "media_type": {
      "type": "string"
    },
    "size_bytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "digest",
    "media_type",
    "size_bytes"
  ],
  "title": "ArtifactRefV1",
  "type": "object"
