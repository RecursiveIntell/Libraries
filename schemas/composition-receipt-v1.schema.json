{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContentDigest": {
      "anyOf": [
        {
          "properties": {
            "hex": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/definitions/DigestMetadata"
            }
          },
          "required": [
            "hex",
            "metadata"
          ],
          "type": "object"
        },
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9A-Fa-f]{64}$",
          "type": "string"
        }
      ],
      "description": "A BLAKE3 content digest with explicit identity context."
    },
    "DigestMetadata": {
      "description": "Identity context cryptographically bound into a content digest.",
      "properties": {
        "algorithm": {
          "description": "Hash algorithm.",
          "type": "string"
        },
        "canonicalization_profile": {
          "description": "Canonicalization algorithm/profile.",
          "type": "string"
        },
        "domain_separator": {
          "description": "Domain separator preventing cross-protocol reuse.",
          "type": "string"
        },
        "schema_id": {
          "description": "Schema identifier for the hashed value.",
          "type": "string"
        },
        "schema_version": {
          "description": "Schema version for the hashed value.",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "canonicalization_profile",
        "domain_separator",
        "schema_id",
        "schema_version"
      ],
      "type": "object"
    }
  },
  "properties": {
    "applicability_context_ref": {
      "type": "string"
    },
    "compiled_obligation_set_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "composition_conflict_set_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "composition_receipt_id": {
      "type": "string"
    },
    "composition_rule_set_ref": {
      "type": "string"
    },
    "degradation_markers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "effective_constitution_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "normalized_input_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "profile_set_ref": {
      "type": "string"
    },
    "replay_handle": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "applicability_context_ref",
    "composition_receipt_id",
    "composition_rule_set_ref",
    "generated_at",
    "normalized_input_digest",
    "profile_set_ref",
    "replay_handle",
    "schema_version"
  ],
  "title": "CompositionReceiptV1",
  "type": "object"
}
