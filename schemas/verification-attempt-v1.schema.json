{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "VerificationAttemptState": {
      "description": "Execution state of a verification attempt.",
      "enum": [
        "scheduled",
        "running",
        "succeeded",
        "failed",
        "advisory_only",
        "blocked"
      ],
      "type": "string"
    }
  },
  "description": "A single execution attempt within a verification case and plan.",
  "properties": {
    "advisory_only": {
      "type": "boolean"
    },
    "attempt_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "degraded": {
      "type": "boolean"
    },
    "finished_at": {
      "type": "string"
    },
    "outcome_signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "state": {
      "$ref": "#/definitions/VerificationAttemptState"
    },
    "trial_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "advisory_only",
    "attempt_id",
    "case_id",
    "degraded",
    "finished_at",
    "plan_id",
    "schema_version",
    "started_at",
    "state"
  ],
  "title": "VerificationAttempt",
  "type": "object"
}
