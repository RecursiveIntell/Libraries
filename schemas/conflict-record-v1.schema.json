    }
  },
  "properties": {
    "authority_agent_id": {
      "type": "string"
    },
    "conflict_id": {
      "type": "string"
    },
    "expected_event_digest": {
      "anyOf": [
        {
          "$ref": "#/definitions/ContentDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_event_digest": {
      "$ref": "#/definitions/ContentDigest"
    },
    "reason_code": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "authority_agent_id",
    "conflict_id",
    "observed_event_digest",
    "reason_code",
    "recorded_at",
    "schema_version",
    "task_id"
  ],
  "title": "ConflictRecordV1",
  "type": "object"
}
