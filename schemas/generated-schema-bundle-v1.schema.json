{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContentDigest": {
      "anyOf": [
        {
          "properties": {
            "hex": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/definitions/DigestMetadata"
            }
          },
          "required": [
            "hex",
            "metadata"
          ],
          "type": "object"
        },
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9A-Fa-f]{64}$",
          "type": "string"
        }
      ],
      "description": "A BLAKE3 content digest with explicit identity context."
    },
    "DigestMetadata": {
      "description": "Identity context cryptographically bound into a content digest.",
      "properties": {
        "algorithm": {
          "description": "Hash algorithm.",
          "type": "string"
        },
        "canonicalization_profile": {
          "description": "Canonicalization algorithm/profile.",
          "type": "string"
        },
        "domain_separator": {
          "description": "Domain separator preventing cross-protocol reuse.",
          "type": "string"
        },
        "schema_id": {
          "description": "Schema identifier for the hashed value.",
          "type": "string"
        },
        "schema_version": {
          "description": "Schema version for the hashed value.",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "canonicalization_profile",
        "domain_separator",
        "schema_id",
        "schema_version"
      ],
      "type": "object"
    },
    "GeneratedAdmissionState": {
      "enum": [
        "advisory_only",
        "non_admitted",
        "human_vetoed"
      ],
      "type": "string"
    },
    "GeneratedSchemaFileV1": {
      "properties": {
        "digest": {
          "$ref": "#/definitions/ContentDigest"
        },
        "path": {
          "type": "string"
        },
        "source_node_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "digest",
        "path"
      ],
      "type": "object"
    }
  },
  "properties": {
    "admission_state": {
      "$ref": "#/definitions/GeneratedAdmissionState"
    },
    "advisory_only": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_files": {
      "default": [],
      "items": {
        "$ref": "#/definitions/GeneratedSchemaFileV1"
      },
      "type": "array"
    },
    "generated_schema_bundle_id": {
      "type": "string"
    },
    "normative_ast_id": {
      "type": "string"
    },
    "proof_obligation_set_id": {
      "type": "string"
    },
    "schema_family": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "spec_bundle_id": {
      "type": "string"
    }
  },
  "required": [
    "admission_state",
    "advisory_only",
    "generated_at",
    "generated_schema_bundle_id",
    "normative_ast_id",
    "proof_obligation_set_id",
    "schema_family",
    "schema_version",
    "spec_bundle_id"
  ],
  "title": "GeneratedSchemaBundleV1",
  "type": "object"
}
